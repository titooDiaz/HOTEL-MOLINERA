# Copia este archivo como `.env`. Solo las variables con prefijo VITE_ llegan al navegador.
# Clave pública de Cloudflare Turnstile. Créala en https://dash.cloudflare.com/ > Turnstile.
# Clave de prueba oficial "siempre pasa": 1x00000000000000000000AA.
# Si se deja vacía en desarrollo, el frontend usa esta clave automáticamente.
# No uses la clave de prueba en producción.
VITE_TURNSTILE_SITE_KEY=

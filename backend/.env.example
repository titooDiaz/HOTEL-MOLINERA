# Copia este archivo como `.env` y ajusta los valores. No subas `.env` al repositorio.
PORT=3000

# En producción define NODE_ENV=production: exige claves reales de Turnstile y SMTP.
# NODE_ENV=production

DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_clave_mysql
DB_NAME=hotel_molinera
DB_DIALECT=mysql

# Cuenta administradora inicial (se crea al arrancar si el correo no existe).
ADMIN_EMAIL=admin@tuhotel.com
ADMIN_PASSWORD=una_clave_segura_de_al_menos_8_caracteres
ADMIN_NAME=Administrador Hotel
HOTEL_NAME=Hotel Molinera

# Cliente inicial opcional: se crea como huésped si el correo todavía no existe.
# Define estos cinco valores juntos y usa una contraseña distinta en cada entorno.
DEFAULT_CLIENT_EMAIL=cliente@tuhotel.com
DEFAULT_CLIENT_PASSWORD=una_clave_segura
DEFAULT_CLIENT_NAME=Cliente De Prueba
DEFAULT_CLIENT_DOCUMENT_TYPE=CC
DEFAULT_CLIENT_DOCUMENT_NUMBER=DOC-CLIENTE-001
DEFAULT_CLIENT_PHONE=0000000000

# Correo para la verificación en dos pasos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hotelmolinera@gmail.com
SMTP_PASSWORD=xeliofjflticonou
MAIL_FROM="Hotel Molinera <hotelmolinera@gmail.com>"

# Cloudflare Turnstile (captcha de contacto y registro).
# Crea el sitio en https://dash.cloudflare.com/ > Turnstile y pega la clave secreta.
# En desarrollo, si la dejas vacía, se usa automáticamente la clave oficial de prueba.
# Clave de prueba oficial "siempre pasa": 1x0000000000000000000000000000000AA
# Las claves de prueba se rechazan si NODE_ENV=production.
TURNSTILE_SECRET_KEY=

# Opcional: dominios permitidos separados por coma (ej. hotelmolinera.com,www.hotelmolinera.com).
# Si se define, el token debe haber sido emitido para uno de ellos.
TURNSTILE_HOSTNAMES=

# Chatbot local con Ollama.
# Instala Ollama y ejecuta: ollama pull qwen2.5:0.5b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
